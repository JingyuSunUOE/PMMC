#!/usr/bin/env python3
import os
import shutil
import signal
import sys
from pathlib import Path

if sys.version_info < (3, 11):  # noqa: UP036 - often invoked via an older system python3.
    if not os.environ.get("_PMMC_HOST_REEXEC"):
        for candidate in (
            "python3.12",
            "python3.11",
            Path(__file__).resolve().parents[1] / ".venv/bin/python",
        ):
            binary = shutil.which(str(candidate))
            if binary:
                os.environ["_PMMC_HOST_REEXEC"] = "1"
                os.execv(binary, [binary, "-B", __file__, *sys.argv[1:]])
    sys.exit("pmmc: the host launcher requires Python 3.11 or later")

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from release_host.cli import main  # noqa: E402

if __name__ == "__main__":
    def detach(_signal, _frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, detach)
    raise SystemExit(main())
